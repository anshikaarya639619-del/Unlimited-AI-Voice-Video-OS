APP_NAME=Unlimited AI Voice Video OS
DATA_DIR=./data
# Choose one: mock, kokoro, gpt-sovits, http. Multiple real providers are tried in order:
# TTS_PROVIDER=kokoro,gpt-sovits
TTS_PROVIDER=kokoro
TTS_HTTP_TIMEOUT=300
TTS_SPEED=1.0
MAX_CHUNK_CHARS=700
CHUNK_RETRIES=2
FFMPEG_BIN=ffmpeg

# Kokoro-FastAPI: run ghcr.io/remsky/kokoro-fastapi-cpu:latest on port 8880
KOKORO_BASE_URL=http://127.0.0.1:8880
KOKORO_MODEL=kokoro
KOKORO_VOICE=af_heart

# GPT-SoVITS api_v2.py: run API on port 9880
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
# This path must exist on the GPT-SoVITS server, not just this app container.
GPT_SOVITS_REF_AUDIO_PATH=/path/on/gpt-sovits-server/reference.wav
GPT_SOVITS_PROMPT_TEXT=Exact words spoken in the reference audio.
GPT_SOVITS_PROMPT_LANG=en
GPT_SOVITS_TEXT_LANG=en
GPT_SOVITS_BATCH_SIZE=1
